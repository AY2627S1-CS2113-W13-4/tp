@startuml
!include style.iuml
title record-meal 2: store and display a selected recipe
autonumber

participant "mishMash:MishMash" as App
participant "command:RecordMealCommand" as Command
participant "recipeBook:RecipeBook" as Book
participant "mealLog:MealLog" as Log
participant "viewer:MealLogViewer" as Viewer

App -> Command : execute(recipeBook)
activate Command
Command -> Book : getRecipes()
activate Book
Book --> Command : recipes
deactivate Book
Command -> Log : record(recipes.get(1))
activate Log
Log --> Command : void
deactivate Log
Command -> Log : getTotals()
activate Log
Log --> Command : totals
deactivate Log
create Viewer
Command -> Viewer : new MealLogViewer()
activate Viewer
Viewer --> Command : viewer
deactivate Viewer
Command -> Viewer : viewRecorded(recipe, totals)
activate Viewer
Viewer --> Command : formatted result
deactivate Viewer
Command --> App : formatted result
deactivate Command
@enduml
