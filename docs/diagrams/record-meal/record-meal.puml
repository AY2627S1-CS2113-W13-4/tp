@startuml
!include style.iuml
title Recording a meal: record-meal 2
autonumber

participant "mishMash:MishMash" as App
participant "parser:Parser" as Parser
participant "cmd:RecordMealCommand" as Cmd
participant "recipeBook:RecipeBook" as Book
participant "mealLog:MealLog" as Log
participant "viewer:MealLogViewer" as Viewer

App -> Parser : parseCommand("record-meal 2")
activate Parser
note over Parser
  parseNamedCommand dispatches to
  parseRecordMeal(arguments), which accepts
  exactly one positive whole number.
end note
create Cmd
Parser -> Cmd : new RecordMealCommand(2, mealLog)
activate Cmd
Cmd --> Parser : cmd
deactivate Cmd
Parser --> App : cmd
deactivate Parser

note over App, Cmd
  The inherited confirmationPrompt returns an empty Optional,
  so the command runs without confirmation. That step is omitted.
end note

App -> Cmd : execute(recipeBook)
activate Cmd
Cmd -> Book : getRecipes()
Book --> Cmd : recipes
alt recipes is empty or index > recipes.size()
  Cmd --> App : throws MishMashException
else index is valid
  note over Cmd, Book : Select recipe = recipes.get(index - 1).
  Cmd -> Log : record(recipe)
  Cmd -> Log : getTotals()
  Log --> Cmd : totals: NutritionTotals
  create Viewer
  Cmd -> Viewer : new MealLogViewer()
  activate Viewer
  Viewer --> Cmd : viewer
  deactivate Viewer
  Cmd -> Viewer : viewRecorded(recipe, totals)
  Viewer --> Cmd : formatted text
  Cmd --> App : meal name, its nutrition,\nand the running totals
end
deactivate Cmd
@enduml
