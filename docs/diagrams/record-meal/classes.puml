@startuml
!pragma layout smetana
!include style.iuml
title Meal recording commands and collaborators
top to bottom direction
skinparam nodesep 35
skinparam ranksep 55
hide empty members

interface Command <<interface>> {
  + execute(recipeBook: RecipeBook): String
}
class RecordMealCommand {
  + execute(recipeBook: RecipeBook): String
}
class ViewMealsCommand {
  + execute(recipeBook: RecipeBook): String
}
class MealLog
class MealLogViewer {
  + view(meals: List<Recipe>, totals: NutritionTotals): String
  + viewRecorded(meal: Recipe, totals: NutritionTotals): String
}
class RecipeBook

RecordMealCommand ..|> Command
ViewMealsCommand ..|> Command
RecordMealCommand --> "1" MealLog : -mealLog
ViewMealsCommand --> "1" MealLog : -mealLog
RecordMealCommand ..> RecipeBook : reads
RecordMealCommand ..> MealLogViewer : creates and calls
ViewMealsCommand ..> MealLogViewer : creates and calls

legend bottom
  Only feature-relevant members are shown.
endlegend
@enduml
