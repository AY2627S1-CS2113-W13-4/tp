@startuml
!include style.iuml
title view-meals: display a non-empty meal log
autonumber

participant "mishMash:MishMash" as App
participant "command:ViewMealsCommand" as Command
participant "mealLog:MealLog" as Log
participant "viewer:MealLogViewer" as Viewer

App -> Command : execute(recipeBook)
activate Command
Command -> Log : getMeals()
activate Log
Log --> Command : meals
deactivate Log
Command -> Log : getTotals()
activate Log
Log --> Command : totals
deactivate Log
create Viewer
Command -> Viewer : new MealLogViewer()
activate Viewer
Viewer --> Command : viewer
deactivate Viewer
Command -> Viewer : view(meals, totals)
activate Viewer
Viewer --> Command : formatted meals and totals
deactivate Viewer
Command --> App : formatted meals and totals
deactivate Command
@enduml
