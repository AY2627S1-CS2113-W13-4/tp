@startuml
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 17
skinparam shadowing false
skinparam monochrome true
hide footbox
' Solid filled call arrows and dashed return arrows follow the course notation.
' Keep notes beside lifelines so activation bars stay visible.
participant "mishMash:MishMash" as App
participant "command:SetDietCommand" as C
participant "planner:DietaryPlanner" as P
participant "generator:MealPlanGenerator" as G
App -> C : execute(recipeBook)
activate C
C -> P : repair(...)
activate P
note left of P : Count conflicting days;\nretain daily targets.
P -> P : generate(...)
activate P
note left of P : Filter eligible recipes.
P -> G : generate(...)
activate G
G --> P : replacementPlan
deactivate G
P --> P : replacementPlan
deactivate P
note left of P : Reuse compatible days;\nreplace conflicting days.
P --> C : updatedPlan
deactivate P
note right of C : Continue in Figure 8.
deactivate C
@enduml
