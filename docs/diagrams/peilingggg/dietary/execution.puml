@startuml
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 17
skinparam shadowing false
skinparam monochrome true
hide footbox
' Constructor creation reaches the object box; its activation starts below the box.
' Solid filled call arrows and dashed returns follow the course notation.
participant "mishMash:MishMash" as App
participant "command:SetDietCommand" as C
participant "groceries:GroceryListGenerator" as G
participant "activePlan:ActiveMealPlan" as A
participant "settings:DietarySettings" as S
App -> C : execute(recipeBook)
activate C
ref over C : Repair returns updatedPlan (Figure 7)
C -> A : getGroceryList()
activate A
A --> C : snapshot present
deactivate A
create G
C -> G : new\nGroceryListGenerator()
activate G
G --> C
deactivate G
C -> G : generateForPlan(...)
activate G
G --> C : groceries
deactivate G
C -> A : setGenerated(updatedPlan,\nrequest, groceries)
activate A
A --> C
deactivate A
C -> S : set(preferences)
activate S
S --> C
deactivate S
C --> App : result
deactivate C
@enduml
