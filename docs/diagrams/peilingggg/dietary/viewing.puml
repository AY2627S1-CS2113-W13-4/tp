@startuml
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 17
skinparam shadowing false
skinparam monochrome true
hide footbox
participant "mishMash:MishMash" as App
participant "parser:Parser" as P
participant "view:Command" as C
participant "settings:DietarySettings" as S
participant "profile:DietaryPreferences" as D
App -> P : parseCommand("view-diet")
activate P
P -> P : requireNoDietArguments(...)
activate P
P --> P
deactivate P
create C
P -> C : create view Command lambda
activate C
C --> P
deactivate C
P --> App : view
deactivate P
note over P, D
  Lambda captures settings; the current profile is read during execution.
end note
App -> C : execute(recipeBook)
activate C
C -> S : get()
activate S
S --> C : current profile
deactivate S
C -> D : describe()
activate D
D --> C : three-line description
deactivate D
C --> App : three-line description
deactivate C
@enduml
