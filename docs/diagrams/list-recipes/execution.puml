@startuml
!include ../rixte/shortfall/style.iuml
title list-recipes 2: display one recipe
autonumber

participant "mishMash:MishMash" as App
participant "command:ListRecipeCommand" as Command
participant "recipeBook:RecipeBook" as Book
participant "viewer:RecipeViewer" as Viewer

App -> Command : execute(recipeBook)
activate Command
Command -> Book : getRecipes()
activate Book
Book --> Command : recipes
deactivate Book
create Viewer
Command -> Viewer : new RecipeViewer()
activate Viewer
Viewer --> Command : viewer
deactivate Viewer
Command -> Viewer : view(recipes.get(1))
activate Viewer
Viewer --> Command : formatted recipe
deactivate Viewer
Command --> App : formatted recipe
deactivate Command
@enduml
