@startuml
!pragma layout smetana
!include ../rixte/shortfall/style.iuml

title Listing recipes: selected classes and relationships
top to bottom direction
skinparam nodesep 55
skinparam ranksep 85
hide empty members

class Parser {
  + parseCommand(input: String): Command
  - parseListRecipe(arguments: String): Command
  - parseRecipeIndex(arguments: String): int
}
interface Command {
  + confirmationPrompt(recipeBook: RecipeBook): Optional<String>
  + execute(recipeBook: RecipeBook): String
}
class ListRecipeCommand {
  - index: Integer [0..1]
  + execute(recipeBook: RecipeBook): String
}
class RecipeBook {
  + getRecipes(): List<Recipe>
}
class Recipe {
  - name: String
  - calories: int
  + getName(): String
  + getCalories(): int
}
class RecipeViewer {
  + view(recipe: Recipe): String
}

Parser ..> ListRecipeCommand : creates
ListRecipeCommand .up.|> Command
ListRecipeCommand ..> RecipeBook : execution parameter
ListRecipeCommand ..> RecipeViewer : creates
ListRecipeCommand ..> Recipe : reads name and calories
RecipeBook --> "0..*" Recipe : -recipes\n{ordered, nonunique}
RecipeViewer ..> Recipe : reads
Parser -[hidden]right-> Command

legend bottom
  Only feature-relevant members are shown; constructors and most recipe getters are omitted.
  index is null when no index was typed (list every recipe); otherwise it is the one-based number shown to the user.
  Solid arrows show stored references; dashed arrows show dependencies or interface realization.
  RecipeBook is passed to execute, not retained by ListRecipeCommand. getRecipes returns a read-only copy.
endlegend
@enduml
