@startuml
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 17
skinparam shadowing false
skinparam monochrome true
hide footbox
participant "command:\nSetDietCommand" as C
participant "groceries:\nGroceryListGenerator" as G
participant "activePlan:\nActiveMealPlan" as A
participant "settings:\nDietarySettings" as S
activate C
C -> A : getGroceryList()
activate A
A --> C : snapshot present
deactivate A
create G
C -> G : new GroceryListGenerator()
C -> G : generateForPlan(...)
activate G
G --> C : groceries
deactivate G
C -> A : setGenerated(updatedPlan,\nrequest, groceries)
activate A
A --> C
deactivate A
C -> S : set(preferences)
activate S
S --> C
deactivate S
C -->[ : result
deactivate C
@enduml
