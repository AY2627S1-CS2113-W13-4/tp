@startuml
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 17
skinparam shadowing false
skinparam monochrome true
hide footbox
participant "command:\nSetDietCommand" as C
participant "planner:\nDietaryPlanner" as P
participant "generator:\nMealPlanGenerator" as G
[-> C : execute(...)
activate C
C -> P : repair(...)
activate P
note over P : Count conflicting days;\nretain daily targets.
P -> P : generate(...)
activate P
note over P : Filter eligible recipes.
P -> G : generate(...)
activate G
G --> P : replacementPlan
deactivate G
P --> P : replacementPlan
deactivate P
note over P : Reuse compatible days;\nreplace conflicting days.
P --> C : updatedPlan
deactivate P
note over C : Continue in Figure 8.
deactivate C
@enduml
