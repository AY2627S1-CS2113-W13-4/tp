@startuml
!pragma layout smetana
' Styling is inline so browser renderers need no neighbouring files.
' Visual settings matching the existing shortfall diagrams.
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ArrowColor #475569
skinparam LineColor #475569
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F5F8FC
skinparam classBorderColor #475569
skinparam componentBackgroundColor #F5F8FC
skinparam componentBorderColor #475569
skinparam participantBackgroundColor #F5F8FC
skinparam participantBorderColor #475569
skinparam sequenceLifeLineBorderColor #94A3B8
skinparam sequenceGroupBackgroundColor #FFFFFF
skinparam sequenceGroupBorderColor #94A3B8
skinparam noteBackgroundColor #FFF9E8
skinparam noteBorderColor #C4AC70
skinparam maxMessageSize 240
hide footbox
title Adding a recipe: architectural context
top to bottom direction

component "Terminal interaction\nMishMash" as App
component "Command parsing\nParser" as Parsing
component "Addition action\nAddRecipeCommand" as Addition
component "Recipe formatting\nRecipeViewer" as Formatting
component "Session models\nRecipeBook, Recipe, GroceryItem" as Models

App ..> Parsing : parseCommand(input)
Parsing ..> Addition : creates validated command
Parsing ..> Models : creates ingredients and recipe
App ..> Addition : execute(recipeBook)\nvia Command
Addition ..> Formatting : creates viewer; view(recipe)
Formatting ..> Models : reads recipe details
Addition ..> Models : appends recipe to book

note bottom of Addition
  Formats the confirmation before insertion.
  No confirmation question is required.
end note
legend bottom
  Feature-level groupings of existing classes; unrelated features are omitted.
  Dashed arrows show dependencies, not runtime message order or new interfaces.
  MishMash displays the returned text and prompts for the next command.
endlegend
@enduml
