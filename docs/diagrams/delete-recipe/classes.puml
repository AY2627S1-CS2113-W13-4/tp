@startuml
!pragma layout smetana
!include ../rixte/shortfall/style.iuml
hide circle

title Recipe deletion: selected classes and relationships
top to bottom direction
skinparam nodesep 55
skinparam ranksep 85
hide empty members

class MishMash {
  - executeCommand(input: String): void
  - userConfirms(question: String): boolean
}
class Parser {
  + parseCommand(input: String): Command
  - parseDeleteRecipe(arguments: String): Command
}
interface Command <<interface>> {
  + confirmationPrompt(recipeBook: RecipeBook): Optional<String>
  + execute(recipeBook: RecipeBook): String
}
class DeleteRecipeCommand {
  - index: int
  + confirmationPrompt(recipeBook: RecipeBook): Optional<String>
  + execute(recipeBook: RecipeBook): String
  - findTarget(recipeBook: RecipeBook): Recipe
}
class RecipeBook {
  + size(): int
  + getRecipes(): List<Recipe>
  + remove(index: int): Recipe
}
class Recipe {
  - name: String
  + getName(): String
}

MishMash --> "1" Parser : -parser
MishMash ..> Command : asks, then executes
Parser ..> DeleteRecipeCommand : creates
DeleteRecipeCommand .up.|> Command
DeleteRecipeCommand ..> RecipeBook : execution parameter
RecipeBook --> "0..*" Recipe : -recipes\n{ordered, nonunique}

legend bottom
  Only feature-relevant members are shown.
endlegend
@enduml
