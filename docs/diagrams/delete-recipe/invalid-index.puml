@startuml
!include ../rixte/shortfall/style.iuml
title delete-recipe: reject an invalid index before confirmation
autonumber

participant "mishMash:MishMash" as App
participant "deleteCommand:DeleteRecipeCommand" as Delete
participant "recipeBook:RecipeBook" as Book

App -> Delete : confirmationPrompt(recipeBook)
activate Delete
Delete -> Delete : findTarget(recipeBook)
activate Delete
Delete -> Book : size()
activate Book
Book --> Delete : recipeCount
deactivate Book
Delete --> Delete : throws MishMashException
deactivate Delete
Delete --> App : throws MishMashException
deactivate Delete
@enduml
