@startuml
!include ../rixte/shortfall/style.iuml
title delete-recipe 2: confirm and delete
autonumber

actor User
participant "mishMash:MishMash" as App
participant "deleteCommand:DeleteRecipeCommand" as Delete
participant "recipeBook:RecipeBook" as Book

App -> Delete : confirmationPrompt(recipeBook)
activate Delete
Delete -> Delete : findTarget(recipeBook)
activate Delete
Delete -> Book : size()
activate Book
Book --> Delete : recipeCount
deactivate Book
Delete -> Book : getRecipes()
activate Book
Book --> Delete : recipes
deactivate Book
Delete --> Delete : target recipe
deactivate Delete
Delete --> App : Optional.of(question)
deactivate Delete

App -> App : userConfirms(question)
activate App
App -> User : display question
User -> App : "y"
App --> App : true
deactivate App

App -> Delete : execute(recipeBook)
activate Delete
Delete -> Delete : findTarget(recipeBook)
activate Delete
Delete -> Book : size()
activate Book
Book --> Delete : recipeCount
deactivate Book
Delete -> Book : getRecipes()
activate Book
Book --> Delete : recipes
deactivate Book
Delete --> Delete : target recipe
deactivate Delete
Delete -> Book : remove(index - 1)
activate Book
Book --> Delete : deleted recipe
deactivate Book
Delete -> Book : size()
activate Book
Book --> Delete : recipes remaining
deactivate Book
Delete --> App : deletion confirmation
deactivate Delete
App -> User : display result
@enduml
