@startuml
!pragma layout smetana
!include ../rixte/shortfall/style.iuml
hide circle

title Parsing saved-target changes
top to bottom direction
skinparam nodesep 35
skinparam ranksep 55
hide empty members

class Parser {
  - parseSetTargets(arguments: String): Command
}
class SetTargetsParser {
  + parse(arguments: String): TargetChanges
}
class TargetChanges
class SetTargetsCommand

Parser ..> SetTargetsParser : creates and calls
SetTargetsParser ..> TargetChanges : creates
Parser ..> SetTargetsCommand : creates
SetTargetsCommand --> "1" TargetChanges : -changes

legend bottom
  Only feature-relevant members are shown.
endlegend
@enduml
