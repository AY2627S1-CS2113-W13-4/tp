@startuml
!include ../rixte/shortfall/style.iuml
title generate-plan: publish a successful plan
autonumber

participant "command:GeneratePlanCommand" as Command
participant "planner:DietaryPlanner" as Planner
participant "activePlan:ActiveMealPlan" as Active

create Planner
Command -> Planner : new DietaryPlanner(generator)
activate Planner
Planner --> Command : planner
deactivate Planner
Command -> Planner : generate(recipes, effectiveRequest, preferences)
activate Planner
Planner --> Command : plan
deactivate Planner
Command -> Active : setGenerated(plan, effectiveRequest, Optional.empty())
activate Active
Active --> Command : void
deactivate Active
@enduml
