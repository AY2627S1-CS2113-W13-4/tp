@startuml
!include ../rixte/shortfall/style.iuml
title set-targets: reject invalid input before creating a command
autonumber

participant "mishMash:MishMash" as App
participant "parser:Parser" as Parser
participant "setTargetsParser:SetTargetsParser" as TargetParser

App -> Parser : parseCommand("set-targets cal/0")
activate Parser
create TargetParser
Parser -> TargetParser : new SetTargetsParser()
activate TargetParser
TargetParser --> Parser : setTargetsParser
deactivate TargetParser
Parser -> TargetParser : parse("cal/0")
activate TargetParser
TargetParser --> Parser : throws IllegalArgumentException
deactivate TargetParser
Parser --> App : throws MishMashException with usage
deactivate Parser
@enduml
