@startuml
!include ../rixte/shortfall/style.iuml
title set-targets: parse valid changes
autonumber

participant "mishMash:MishMash" as App
participant "parser:Parser" as Parser
participant "targetParser:SetTargetsParser" as TargetParser
participant "command:SetTargetsCommand" as Command

App -> Parser : parseCommand("set-targets cal/2000 p/none")
activate Parser
create TargetParser
Parser -> TargetParser : new SetTargetsParser()
activate TargetParser
TargetParser --> Parser : targetParser
deactivate TargetParser
Parser -> TargetParser : parse("cal/2000 p/none")
activate TargetParser
TargetParser --> Parser : changes
deactivate TargetParser
create Command
Parser -> Command : new SetTargetsCommand(changes, settings)
activate Command
Command --> Parser : command
deactivate Command
Parser --> App : command
deactivate Parser
@enduml
