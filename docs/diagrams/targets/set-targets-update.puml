@startuml
!include ../rixte/shortfall/style.iuml
title set-targets: apply valid changes
autonumber

participant "mishMash:MishMash" as App
participant "command:SetTargetsCommand" as Command
participant "settings:TargetSettings" as Settings
participant "changes:TargetChanges" as Changes

App -> Command : execute(recipeBook)
activate Command
Command -> Settings : get()
activate Settings
Settings --> Command : current targets
deactivate Settings
Command -> Changes : applyTo(current)
activate Changes
Changes --> Command : updated targets
deactivate Changes
Command -> Settings : set(updated)
activate Settings
Settings --> Command : void
deactivate Settings
Command --> App : saved-target summary
deactivate Command
@enduml
