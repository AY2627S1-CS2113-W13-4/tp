@startuml
!pragma layout smetana
!include ../rixte/shortfall/style.iuml
hide circle

title Daily target values and changes
top to bottom direction
skinparam nodesep 35
skinparam ranksep 55
hide empty members

class TargetChanges {
  - changes: Map<Nutrient, Optional<Integer>>
  + applyTo(current: NutritionTargets): NutritionTargets
}
class TargetSettings {
  - targets: NutritionTargets
  + get(): NutritionTargets
  + set(targets: NutritionTargets): void
}
class NutritionTargets {
  - calories: Integer [0..1]
  - protein: Integer [0..1]
  - carbs: Integer [0..1]
  - fats: Integer [0..1]
}
enum Nutrient <<enumeration>> {
  CALORIES
  PROTEIN
  CARBS
  FATS
}

TargetSettings --> "1" NutritionTargets : -targets
TargetChanges ..> Nutrient
TargetChanges ..> NutritionTargets : creates
NutritionTargets ..> Nutrient

legend bottom
  Only feature-relevant members are shown.
endlegend
@enduml
