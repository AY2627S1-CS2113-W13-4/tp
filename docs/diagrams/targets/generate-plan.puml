@startuml
!include ../rixte/shortfall/style.iuml
title generate-plan: merge saved and typed targets
autonumber

participant "mishMash:MishMash" as App
participant "command:GeneratePlanCommand" as Command
participant "settings:TargetSettings" as Settings
participant "savedTargets:NutritionTargets" as Saved

App -> Command : execute(recipeBook)
activate Command
Command -> Settings : get()
activate Settings
Settings --> Command : savedTargets
deactivate Settings
Command -> Saved : overriddenBy(request.targets())
activate Saved
Saved --> Command : merged targets
deactivate Saved
ref over Command
  Generate and publish the plan
end ref
Command --> App : generation confirmation
deactivate Command
@enduml
