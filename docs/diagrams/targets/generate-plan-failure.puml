@startuml
!include ../rixte/shortfall/style.iuml
title generate-plan: keep the active plan after generation failure
autonumber

participant "mishMash:MishMash" as App
participant "command:GeneratePlanCommand" as Command
participant "planner:DietaryPlanner" as Planner

App -> Command : execute(recipeBook)
activate Command
ref over Command
  Merge saved and typed targets
end ref
create Planner
Command -> Planner : new DietaryPlanner(generator)
activate Planner
Planner --> Command : planner
deactivate Planner
Command -> Planner : generate(recipes, effectiveRequest, preferences)
activate Planner
Planner --> Command : throws IllegalArgumentException
deactivate Planner
Command --> App : throws MishMashException
deactivate Command
@enduml
