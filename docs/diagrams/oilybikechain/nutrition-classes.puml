@startuml
!pragma layout smetana
!include ../rixte/shortfall/style.iuml
hide circle

title Combined daily nutrition totals
top to bottom direction
skinparam nodesep 35
skinparam ranksep 55
hide empty members

class DayPlan {
  + calculateDailyNutritionTotals(): NutritionTotals
  + getTotalCalories(): long
  + getTotalProtein(): long
  + getTotalCarbs(): long
  + getTotalFats(): long
}
class Recipe {
  + getCalories(): int
  + getProtein(): int
  + getCarbs(): int
  + getFats(): int
}
class NutritionTotals <<record>> {
  - calories: long
  - protein: long
  - carbs: long
  - fats: long
}

DayPlan --> "0..*" Recipe : -meals\n{ordered, nonunique}
DayPlan ..> NutritionTotals : creates

legend bottom
  Only feature-relevant members are shown.
endlegend
@enduml
