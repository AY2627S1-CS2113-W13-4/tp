@startuml
!include ../rixte/shortfall/style.iuml
title generate-list: aggregate and publish a completed snapshot
autonumber

participant "mishMash:MishMash" as App
participant "command:GenerateListCommand" as Command
participant "generator:GroceryListGenerator" as Generator
participant "activePlan:ActiveMealPlan" as Active

App -> Command : execute(recipeBook)
activate Command
ref over Command
  Collect ingredients from the active plan
end ref
create Generator
Command -> Generator : new GroceryListGenerator()
activate Generator
Generator --> Command : generator
deactivate Generator
Command -> Generator : generate(ingredients)
activate Generator
Generator --> Command : groceries
deactivate Generator
Command -> Active : setGroceryList(groceries)
activate Active
Active --> Command : void
deactivate Active
Command --> App : generation confirmation
deactivate Command
@enduml
