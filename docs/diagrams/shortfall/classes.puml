'@@author Rixte
@startuml
!pragma layout smetana
!include readable.iuml
title Shortfall command relationships
top to bottom direction
skinparam ranksep 75
skinparam nodesep 35
hide empty members
class Parser {
 - activeMealPlan: ActiveMealPlan
}
class CheckShortfallParser {
 + parse(arguments: String): NutritionTargets
}
interface Command <<interface>>
class CheckShortfallCommand {
 + execute(recipeBook: RecipeBook): String
 - findShortfalls(day: DayPlan): List<String>
}
class ActiveMealPlan
class NutritionTargets
Parser ..> CheckShortfallParser : creates
Parser ..> CheckShortfallCommand : creates
CheckShortfallParser ..> NutritionTargets : creates
CheckShortfallCommand ..|> Command
CheckShortfallCommand --> "1\n-activePlan" ActiveMealPlan
CheckShortfallCommand --> "1\n-targets" NutritionTargets

@enduml
'@@author
