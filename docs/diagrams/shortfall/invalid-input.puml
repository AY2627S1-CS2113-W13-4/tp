'@@author Rixte
@startuml
!include readable.iuml
title Rejecting a zero target
participant MishMash as App
participant Parser
participant "Target parser" as TargetParser
note over App : Input: check-shortfall cal/0
App -> Parser : parseCommand(\ninput)
create TargetParser
Parser -> TargetParser : new\nCheckShortfallParser()
Parser -> TargetParser : parse("cal/0")
TargetParser -> TargetParser : readTarget("cal/0", values)
TargetParser -> TargetParser : parseTarget("0", "cal")
TargetParser --> Parser : throws\nIllegalArgumentException
Parser -> Parser : wrap with usage and cause
Parser --> App : throws MishMashException
App -> App : displayError(exception)
App -> App : displayCommandPrompt()
note over Parser, TargetParser
 No command or targets created.
 No plan data accessed.
end note

@enduml
'@@author
