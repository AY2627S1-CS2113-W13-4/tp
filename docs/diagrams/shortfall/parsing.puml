'@@author Rixte
@startuml
!include readable.iuml
title Parsing a shortfall check
participant Parser
participant "Target parser" as TargetsParser
participant "Targets" as Targets
participant "Check command" as Check
create TargetsParser
Parser -> TargetsParser : new CheckShortfallParser()
Parser -> TargetsParser : parse(arguments)
loop each supplied token
 TargetsParser -> TargetsParser : readTarget(token, values)
 TargetsParser -> TargetsParser : parseTarget(value, prefix)
end
create Targets
TargetsParser -> Targets : new NutritionTargets(\n2000, 100, null, null)
TargetsParser --> Parser : targets
create Check
Parser -> Check : new CheckShortfallCommand(\nactiveMealPlan, targets)
Check -> Targets : hasAnyTarget()
Targets --> Check : true
Check --> Parser : command

@enduml
'@@author
