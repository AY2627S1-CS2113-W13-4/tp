@startuml
!pragma layout smetana
!include readable.iuml
title Shortfall responsibilities
top to bottom direction
component "MishMash\nConsole session" as App
component "Parser +\nCheckShortfallParser" as Parsing
component "CheckShortfallCommand\nRead-only comparison" as Check
component "Session models\nPlan, days, targets" as Models
App ..> Parsing : parse input
Parsing ..> Check : create
App ..> Check : execute
Check ..> Models : read
Parsing ..> Models : share holder;\ncreate targets

legend bottom
  Component responsibility view. Dashed arrows mean "uses"; labels state how each component is used.
endlegend

@enduml
'@@author
