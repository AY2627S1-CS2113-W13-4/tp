'@@author Rixte
@startuml
!pragma layout smetana
!include ../shortfall/readable.iuml
title Recipe edit responsibilities
top to bottom direction
skinparam ranksep 75
skinparam nodesep 25
hide empty members
class Parser
interface Command
class EditRecipeCommand {
 - index: int
 + execute(recipeBook: RecipeBook): String
}
class RecipeChanges <<record>>
class RecipeBook {
 + replace(index: int, recipe: Recipe): void
}
class RecipeViewer
Parser ..> EditRecipeCommand : creates
Parser ..> RecipeChanges : creates
EditRecipeCommand ..|> Command
EditRecipeCommand --> "1\n-changes" RecipeChanges
EditRecipeCommand ..> RecipeBook : execution parameter
EditRecipeCommand ..> RecipeViewer : formats result

@enduml
'@@author
